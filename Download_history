import argparse
from btcbot.market_data import get_coinbase_candles
if __name__=="__main__":
    p=argparse.ArgumentParser(); p.add_argument("--days",type=int,default=30); args=p.parse_args()
    # Coinbase public endpoint returns a bounded recent window; repeated pagination is not implemented here.
    df=get_coinbase_candles(limit=min(300,args.days*1440))
    df.to_csv("reports/coinbase_recent_1m.csv",index=False)
    print(f"Saved {len(df)} recent closed candles. Coinbase endpoint limit applies.")
