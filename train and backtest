"""Baseline evaluation only; not a profitability claim."""
import pandas as pd
from btcbot.market_data import get_coinbase_candles
from btcbot.features import add_features
if __name__=="__main__":
    df=add_features(get_coinbase_candles(limit=300))
    if df.empty: raise SystemExit("No candle data.")
    df["future_return_5m"]=df.close.shift(-5)/df.close-1
    df["ema_up"]=df.ema9>df.ema21
    valid=df.dropna(subset=["future_return_5m"])
    hit=((valid.ema_up & (valid.future_return_5m>0)) | (~valid.ema_up & (valid.future_return_5m<0))).mean()
    print(f"Naive EMA direction hit-rate (exploratory, not walk-forward): {hit:.1%}")
    print("This is not a Kalshi backtest and does not include contract fills or fees.")
