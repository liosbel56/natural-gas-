def esc(x: Any) -> str:
    return _html.escape(str(x)).replace("$", "&#36;")


def _badge(text: str, kind: str) -> str:
    return f"<span class='xb {kind}'>{esc(text)}</span>"


def _card(title: str, body: str, tone: str = "") -> str:
    return f"<div class='xcard {tone}'><div class='xt'>{esc(title)}</div>{body}</div>"


def _kv(rows: List[Tuple[str, Any]]) -> str:
    return "<table class='xkv'>" + "".join(
        f"<tr><td class='k'>{esc(k)}</td><td class='v'>{v if isinstance(v, _Raw) else esc(v)}</td></tr>" for k, v in rows) + "</table>"


class _Raw(str):
    """Texto HTML ya construido (no se escapa)."""


def _f(x: Any, nd: int = 2, pre: str = "", suf: str = "") -> str:
    try:
        if x is None or not np.isfinite(float(x)):
            return UNAVAILABLE
        return f"{pre}{float(x):,.{nd}f}{suf}"
    except (TypeError, ValueError):
        return UNAVAILABLE


def _c(x: Optional[float]) -> str:
    if x is None:
        return UNAVAILABLE
    v = x * 100
    return f"{v:.0f}¢" if abs(v - round(v)) < 0.05 else f"{v:.1f}¢"


def _p(x: Optional[float]) -> str:
    return UNAVAILABLE if x is None or not np.isfinite(x) else f"{x * 100:.1f}%"


def _t(dt: Optional[datetime], tz: Any, fmt: str = "%H:%M:%S") -> str:
    return UNAVAILABLE if dt is None else dt.astimezone(tz).strftime(fmt)


def _md(html: str) -> None:
    import streamlit as st
    st.markdown(html, unsafe_allow_html=True)


