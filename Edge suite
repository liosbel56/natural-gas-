        or "<div class='xl' style='color:#86efac'>Sin errores de conexión ni de API en este momento.</div>"
    _md(_card("Data Diagnostics", table + _kv(info) + f"<div class='xt' style='margin-top:.55rem'>Errores</div>{err_html}"))


