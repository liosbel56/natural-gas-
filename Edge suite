            rows += f"<tr><td>{lab}</td><td>{_badge('SIN DATOS', 'neutral')}</td><td>—</td><td>—</td><td>—</td></tr>"
            continue
        age = None if s.get("ok_at") is None else (now - s["ok_at"]).total_seconds()
        st_ = _badge("OK", "bull") if s["ok"] else _badge(f"ERROR ×{s.get('fails', 1)}", "bear")
