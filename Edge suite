             "<td class='k'>Edad</td><td class='k'>Latencia</td></tr>" + rows + "</table>")
    info: List[Tuple[str, Any]] = [("Última actualización de pantalla", f"{_t(now, tz)} (#{R['data_log']['refresh_n']})")]
    closed_ok = None
    if closed is not None and len(closed):
        last_start = closed["time"].iloc[-1].to_pydatetime()
        end = last_start + timedelta(seconds=60)
        closed_ok = end <= now
        info += [("Edad de la última vela cerrada", f"{max((now - end).total_seconds(), 0):.0f} s (máx. {cfg.candle_max_s} s)"),
                 ("Última vela cerrada (inicio → cierre)", f"{_t(last_start, tz, '%H:%M')} → {_t(end, tz, '%H:%M:%S')}")]
    else:
        info.append(("Edad de la última vela cerrada", UNAVAILABLE))
    raw_n = 0 if cand is None else len(cand["df"])
    info.append(("Velas recibidas de Coinbase", f"{raw_n}" if cand is not None else UNAVAILABLE))
    info.append(("Velas cerradas usadas en indicadores", f"{0 if closed is None else len(closed)}"
