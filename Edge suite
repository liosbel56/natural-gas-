                 else "ninguna recibida (no afecta)"))
    info.append(("¿Todas las velas usadas están cerradas?",
                 _Raw(_badge("SÍ · verificado", "bull") if closed_ok else _badge("NO / sin datos", "bear") if closed_ok is False
                      else _badge(UNAVAILABLE, "neutral"))))
    if cand is not None:
        info.append(("Fuente de las velas", cand.get("source", UNAVAILABLE)))
    errs: List[str] = []
    for name, s in stt.items():
        if s and not s.get("ok") and s.get("error"):
