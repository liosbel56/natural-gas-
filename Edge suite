    fig.add_trace(go.Scatter(x=xs, y=d["macd_signal"], name="Señal", line=dict(color="#f59e0b", width=1.1)), row=3, col=1)
    fig.add_trace(go.Scatter(x=xs, y=d["roc5"] * 100, name="Momentum 5 (%)", line=dict(color="#2dd4bf", width=1.3)), row=4, col=1)
    fig.add_hline(y=0, line=dict(color="#475569", width=1), row=4, col=1)
    fig.add_trace(go.Scatter(x=xs, y=d["adx"], name="ADX", line=dict(color="#fbbf24", width=1.3)), row=5, col=1)
    fig.add_trace(go.Scatter(x=xs, y=d["plus_di"], name="+DI", line=dict(color="#22c55e", width=1)), row=5, col=1)
    fig.add_trace(go.Scatter(x=xs, y=d["minus_di"], name="−DI", line=dict(color="#ef4444", width=1)), row=5, col=1)
    fig.add_hline(y=20, line=dict(color="#64748b", dash="dot", width=1), row=5, col=1)
    if ctr is not None:
        for t0 in (ctr.window_start, ctr.close_time):
            tx = pd.Timestamp(t0).tz_convert(tz).tz_localize(None)
