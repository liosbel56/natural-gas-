def _synth(kind: str, n: int = 220, seed: int = 3, end: Optional[datetime] = None) -> pd.DataFrame:
    rng = np.random.default_rng(seed)
    end = end or datetime(2026, 10, 23, 12, 7, 0, tzinfo=timezone.utc)      # inicio de la última vela cerrada
    if kind == "up":
        rets = rng.normal(0.00018, 0.00040, n)
    elif kind == "down":
        rets = rng.normal(-0.00018, 0.00040, n)
    elif kind == "reversal":
        rets = np.concatenate([rng.normal(0.00018, 0.00040, n - 14), rng.normal(-0.0013, 0.00040, 14)])
    else:  # sideways: ruido alrededor de una media
        rets = None
    if rets is not None:
        closes = 100_000 * np.exp(np.cumsum(rets))
    else:
        base = 100_000 + 14 * np.sin(np.arange(n) / 2.2) + rng.normal(0, 18, n)
        closes = base
    opens = np.concatenate([[closes[0]], closes[:-1]])
    hi = np.maximum(opens, closes) * (1 + np.abs(rng.normal(0, 0.00012, n)))
    lo = np.minimum(opens, closes) * (1 - np.abs(rng.normal(0, 0.00012, n)))
    times = [pd.Timestamp(end - timedelta(minutes=(n - 1 - i))) for i in range(n)]
    return pd.DataFrame({"time": times, "open": opens, "high": hi, "low": lo, "close": closes,
                         "volume": rng.uniform(1, 5, n)})


def _fake_R(closed: pd.DataFrame, side: str = "UP", ask: float = 0.60, yes_if_above: bool = True,
            windows_candles: int = 6, tau: float = 8.0, z: float = 1.2, signal: Optional[str] = None) -> dict:
    last = closed["time"].iloc[-1]
    ws = (last + pd.Timedelta(minutes=1) - pd.Timedelta(minutes=windows_candles)).to_pydatetime()
    ctr = types.SimpleNamespace(ticker="KXBTC15M-T", yes_if_above=yes_if_above, window_start=ws,
                                close_time=ws + timedelta(minutes=15), reference=float(closed["close"].iloc[-1]))
    sides = {"UP": {"ask": ask if side == "UP" else 1 - ask + 0.02, "bid": 0.58, "p": 0.75, "edge": 0.06},
             "DOWN": {"ask": ask if side == "DOWN" else 1 - ask + 0.02, "bid": 0.38, "p": 0.25, "edge": -0.1}}
    sig = signal or f"BUY {side}"
    dec = {"signal": sig, "side": side if sig.startswith("BUY") else None, "best": side, "sides": sides,
           "req_edge": 0.04, "reasons": ["edge ok"], "filters": []}
    return {"closed": closed, "ctr": ctr, "dec": dec, "filters": [], "lean": None, "p_final": 0.75 if side == "UP" else 0.25,
            "mp": {"z": z}, "tau_min": tau, "signal": sig, "blockers": [], "q": {"yes_bid": 0.58, "no_bid": 0.38},
            "mk": {"last_price": 0.6, "liquidity": 120.0, "yes_ask_size": 50, "yes_bid_size": 60, "volume": 100,
                   "open_interest": 40}, "implied": 0.6}


def selftest() -> List[Tuple[str, bool, str]]:
    T: List[Tuple[str, bool, str]] = []

    def chk(name: str, cond: bool, detail: str = "") -> None:
        T.append((name, bool(cond), detail))

    x = XCfg()
    lean_fn = lambda p, dec: None

    up, side, down, rev = _synth("up"), _synth("sideways"), _synth("down", seed=5), _synth("reversal")
    du, ds, dd = add_indicators(up), add_indicators(side), add_indicators(down)

    # Causalidad: añadir velas futuras no cambia el pasado
    full = add_indicators(_synth("up", n=260, seed=3))
    cut = add_indicators(_synth("up", n=260, seed=3).iloc[:200])
    cols = ["ema9", "ema21", "ema50", "rsi", "macd", "macd_hist", "atr", "adx", "plus_di", "roc5", "v_trend", "n_pos"]
    chk("indicadores causales (sin mirar el futuro)", all(np.allclose(full[c].iloc[199], cut[c].iloc[199], equal_nan=True) for c in cols))
    chk("lecturas por vela causales", np.array_equal(reading_series(full, 0)[:200], reading_series(cut, 0)))
    chk("RSI en [0,100] y ATR > 0", bool(du["rsi"].dropna().between(0, 100).all()) and bool((du["atr"] > 0).all()))
    chk("ADX mayor en tendencia fuerte que en lateral",
        add_indicators(_synth("reversal"))["adx"].iloc[-1] > ds["adx"].iloc[-1], f"{add_indicators(_synth('reversal'))['adx'].iloc[-1]:.1f} vs {ds['adx'].iloc[-1]:.1f}")

    # Chart analysis
    chk("tendencia: serie alcista → BULLISH o NEUTRAL (nunca BEARISH)", chart_analysis(du, x)["trend"] in ("BULLISH", "NEUTRAL"),
        chart_analysis(du, x)["trend"])
    chk("tendencia: serie bajista → BEARISH o NEUTRAL (nunca BULLISH)", chart_analysis(dd, x)["trend"] in ("BEARISH", "NEUTRAL"))
    ca_rev = chart_analysis(add_indicators(rev), x)
    chk("tendencia: tras un desplome fuerte → BEARISH", ca_rev["trend"] == "BEARISH", ca_rev["trend"])
    chk("explicación de la tendencia no vacía", len(chart_analysis(du, x)["why"]) >= 3)
    ob = du.copy(); ob.loc[ob.index[-1], "rsi"] = 78.0
    chk("sobrecompra detectada con RSI ≥ 70", chart_analysis(ob, x)["overbought"])

    # Chop
    ch_side = chop_analysis(ds, x)
    chk("CHOP detectado en mercado lateral", ch_side["state"] == "CHOP", f"{ch_side['state']} {ch_side['points']}pts ADX={ch_side['adx']:.1f}")
    ch_tr = chop_analysis(add_indicators(rev), x)
    chk("tendencia fuerte NO es CHOP", ch_tr["state"] != "CHOP", f"{ch_tr['state']} {ch_tr['points']}pts")

    # Compuerta: BUY válido pasa; cada regla lo convierte en WAIT
    ok_idx = None
    for sd in range(1, 60):          # busca una serie alcista suave que cumpla confirmación para probar el camino feliz
        cand = _synth("up", seed=sd)
        R = enhance(_fake_R(cand), x, lean_fn)
        if R["signal"] == "BUY UP":
            ok_idx = sd
            break
    chk("camino feliz: existe un caso BUY UP que supera toda la compuerta", ok_idx is not None)
    if ok_idx is not None:
        base = _synth("up", seed=ok_idx)
        R = enhance(_fake_R(base, ask=0.90), x, lean_fn)
        chk("precio de compra 90¢ → WAIT (ESPERAR)", R["signal"] == "ESPERAR" and any(f["id"] == "price90" and f["status"] == "fail" for f in R["filters"]))
        R = enhance(_fake_R(base, ask=0.89), x, lean_fn)
        chk("precio de compra 89¢ no se bloquea por precio", all(f["status"] != "fail" for f in R["filters"] if f["id"] == "price90"))
        R = enhance(_fake_R(base, windows_candles=1), x, lean_fn)
        chk("contrato recién iniciado (1 vela dentro) → WAIT", R["signal"] == "ESPERAR" and any(f["id"] == "window" and f["status"] == "fail" for f in R["filters"]))
        R = enhance(_fake_R(base, side="DOWN", ask=0.60), x, lean_fn)
        chk("BUY DOWN contra una tendencia alcista → WAIT", R["signal"] == "ESPERAR")
        R = enhance(_fake_R(base, signal="ESPERAR"), x, lean_fn)
        chk("ESPERAR de la app nunca se convierte en BUY", R["signal"] == "ESPERAR")
        n2 = len([f for f in enhance(_fake_R(base), XCfg(confirm_n=2), lean_fn)["filters"] if f["status"] == "fail"])
        n4 = len([f for f in enhance(_fake_R(base), XCfg(confirm_n=4), lean_fn)["filters"] if f["status"] == "fail"])
        chk("exigir más confirmaciones nunca reduce los bloqueos (n=4 ≥ n=2)", n4 >= n2, f"{n4} vs {n2}")
        # una sola confirmación: forzar la última lectura neutral sobre una copia
        c2 = base.copy()
        c2.loc[c2.index[-1], "close"] = c2["close"].iloc[-2] * 0.9975      # última vela cerrada cae fuerte
        c2.loc[c2.index[-1], "low"] = min(c2["low"].iloc[-1], c2["close"].iloc[-1])
        R = enhance(_fake_R(c2), x, lean_fn)
        chk("una vela contraria rompe la confirmación → WAIT", R["signal"] == "ESPERAR")
        Rm = enhance(_fake_R(base), x, lean_fn)
        chk("enhance añade X con todos los módulos", all(k in Rm["X"] for k in ("chart", "chop", "flip", "exit", "contract", "gate")))
    R = enhance(_fake_R(side), x, lean_fn)
    chk("mercado lateral: BUY → WAIT por CHOP", R["signal"] == "ESPERAR" and any(f["id"] == "chop" and f["status"] == "fail" for f in R["filters"]))
    R = enhance(_fake_R(side), XCfg(block_chop=False), lean_fn)
    chk("block_chop=False: CHOP solo avisa (no bloquea por sí solo)", all(not (f["id"] == "chop" and f["blocking"] and f["status"] == "fail") for f in R["filters"]))
    R = enhance({"closed": side.iloc[:30], "dec": {"signal": "ESPERAR", "filters": []}, "ctr": None, "filters": []}, x, lean_fn)
    chk("pocas velas → análisis no disponible (sin inventar)", R["X"]["ok"] is False)

    # Flip risk
    fr_tr = flip_risk(du, x, 1, chop_analysis(du, x), 2.0, 4.0)
    fr_chop = flip_risk(ds, x, 1, ch_side, 0.2, 12.0)
    chk("Flip Risk: lateral y cerca del umbral > tendencia con colchón", fr_chop["risk"] > fr_tr["risk"], f"{fr_chop['risk']:.0f} vs {fr_tr['risk']:.0f}")
    chk("Flip Risk: niveles coherentes con el porcentaje",
        all(f["level"] == ("HIGH" if f["risk"] > x.flip_high else "MEDIUM" if f["risk"] >= x.flip_med else "LOW") for f in (fr_tr, fr_chop)))
    chk("Flip Risk sin dirección → no disponible", flip_risk(du, x, 0, ch_side, None, None)["available"] is False)
    chk("Flip Risk ∈ [0,100]", 0 <= fr_chop["risk"] <= 100)

    # Smart Exit
    ctr = types.SimpleNamespace(yes_if_above=True)
    dr_ = add_indicators(rev)
    ex_bad = exit_watch(dr_, x, "UP", ctr, {"yes_bid": 0.30}, chart_analysis(dr_, x), -1, 0.60)
