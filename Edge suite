def chart_analysis(d: pd.DataFrame, x: XCfg) -> dict:
    r = d.iloc[-1]
    px, atr = float(r["close"]), float(r["atr"])
    pts, why = 0, []
    if r["v_trend"] == 1:
        pts += 2; why.append("EMA 9 > EMA 21 > EMA 50: estructura alcista completa (+2).")
    elif r["v_trend"] == -1:
        pts -= 2; why.append("EMA 9 < EMA 21 < EMA 50: estructura bajista completa (−2).")
    elif r["ema9"] > r["ema21"]:
        pts += 1; why.append("EMA 9 sobre EMA 21, pero sin alineación completa con la EMA 50 (+1).")
    else:
        pts -= 1; why.append("EMA 9 bajo EMA 21, pero sin alineación completa con la EMA 50 (−1).")
    if r["v_px"] != 0:
        pts += int(r["v_px"])
        why.append(f"Precio {'sobre' if r['v_px'] > 0 else 'bajo'} la EMA 21 ({int(r['v_px']):+d}).")
    if r["v_macd"] != 0:
        pts += int(r["v_macd"])
        why.append(f"Histograma MACD {'positivo' if r['v_macd'] > 0 else 'negativo'} ({int(r['v_macd']):+d}).")
    if r["v_mom"] != 0:
        pts += int(r["v_mom"])
        why.append(f"Momentum de 5 velas {'al alza' if r['v_mom'] > 0 else 'a la baja'} ({int(r['v_mom']):+d}).")
    if r["v_rsi"] != 0:
        pts += int(r["v_rsi"])
        why.append(f"RSI {r['rsi']:.0f} {'por encima de 52' if r['v_rsi'] > 0 else 'por debajo de 48'} ({int(r['v_rsi']):+d}).")
    trend = "BULLISH" if pts >= 3 else "BEARISH" if pts <= -3 else "NEUTRAL"
    if trend == "NEUTRAL":
        why.append(f"Puntaje {pts:+d} de ±6: no alcanza ±3, así que no hay tendencia clara.")
    else:
        why.append(f"Puntaje {pts:+d} de ±6 → {trend}.")
    rsi = float(r["rsi"])
    rsi_state = ("OVERBOUGHT (sobrecompra)" if rsi >= x.rsi_ob else "OVERSOLD (sobreventa)" if rsi <= x.rsi_os
                 else "cerca de sobrecompra" if rsi >= x.rsi_ob - 5 else "cerca de sobreventa" if rsi <= x.rsi_os + 5
                 else "zona normal")
    if rsi >= x.rsi_ob:
        why.append(f"RSI {rsi:.0f} ≥ {x.rsi_ob:.0f}: sobrecompra; un alza adicional es más vulnerable a un giro.")
    elif rsi <= x.rsi_os:
        why.append(f"RSI {rsi:.0f} ≤ {x.rsi_os:.0f}: sobreventa; una baja adicional es más vulnerable a un giro.")
    adx = float(r["adx"])
    if adx < x.adx_chop:
        why.append(f"ADX {adx:.0f} < {x.adx_chop:.0f}: la tendencia, si existe, es débil.")
    h = d["macd_hist"].tail(3).to_numpy()
    hist_trend = ("creciendo" if len(h) == 3 and h[2] > h[1] > h[0] else "cayendo" if len(h) == 3 and h[2] < h[1] < h[0]
                  else "mixto")
    return {"trend": trend, "score": pts, "why": why, "price": px, "ema9": float(r["ema9"]), "ema21": float(r["ema21"]),
            "ema50": float(r["ema50"]), "rsi": rsi, "rsi_state": rsi_state, "macd": float(r["macd"]),
            "macd_signal": float(r["macd_signal"]), "macd_hist": float(r["macd_hist"]), "hist_trend": hist_trend,
            "roc5": float(r["roc5"]) if np.isfinite(r["roc5"]) else None,
            "roc10": float(r["roc10"]) if np.isfinite(r["roc10"]) else None,
            "adx": adx, "plus_di": float(r["plus_di"]), "minus_di": float(r["minus_di"]), "atr": atr,
            "overbought": rsi >= x.rsi_ob, "oversold": rsi <= x.rsi_os,
            "dir": 1 if trend == "BULLISH" else -1 if trend == "BEARISH" else 0}


# ──────────────────────────────────────────────────────────────────────────────
# 4. CHOP DETECTION
# ──────────────────────────────────────────────────────────────────────────────
def chop_analysis(d: pd.DataFrame, x: XCfg) -> dict:
    r = d.iloc[-1]
    atr, px = float(r["atr"]), float(r["close"])
    adx = float(r["adx"])
    emas = [float(r["ema9"]), float(r["ema21"]), float(r["ema50"])]
    spread_atr = (max(emas) - min(emas)) / atr if atr > 0 else float("nan")
    atr_ratio = atr / float(d["atr"].tail(60).mean()) if float(d["atr"].tail(60).mean()) > 0 else float("nan")
    sg = np.sign(d["close"].diff().tail(13).to_numpy()[1:])
    pairs = [(a, b) for a, b in zip(sg[:-1], sg[1:]) if a != 0 and b != 0]
    flips = (sum(1 for a, b in pairs if a != b) / len(pairs)) if len(pairs) >= 6 else float("nan")
    cs = np.sign((d["ema9"] - d["ema21"]).tail(21).to_numpy())
    crosses = int(sum(1 for a, b in zip(cs[:-1], cs[1:]) if a != 0 and b != 0 and a != b))

    pts, items = 0, []

    def add(p: int, text: str) -> None:
        nonlocal pts
        pts += p
        items.append((p, text))

    if adx < x.adx_chop - 5:
        add(2, f"ADX {adx:.0f} muy bajo (< {x.adx_chop - 5:.0f}): sin tendencia")
    elif adx < x.adx_chop:
        add(1, f"ADX {adx:.0f} bajo (< {x.adx_chop:.0f}): tendencia débil")
    if np.isfinite(spread_atr):
        if spread_atr < 0.6:
            add(2, f"EMA 9/21/50 casi pegadas (separación {spread_atr:.2f} ATR)")
        elif spread_atr < 1.2:
            add(1, f"EMA 9/21/50 poco separadas ({spread_atr:.2f} ATR)")
    if np.isfinite(atr_ratio) and atr_ratio < 0.75:
        add(1, f"ATR comprimido ({atr_ratio:.2f}× su media de 60 velas)")
    if np.isfinite(flips) and flips >= 0.70:
        add(1, f"Cambios de dirección frecuentes ({flips * 100:.0f}% de las últimas velas alternan)")
    if crosses >= 2:
        add(1, f"{crosses} cruces EMA 9/21 en las últimas 20 velas")
    state = "CHOP" if pts >= x.chop_points else "MIXED" if pts == x.chop_points - 1 else "TRENDING"
    return {"state": state, "points": pts, "max_points": 7, "items": items, "adx": adx, "atr": atr,
            "atr_pct": atr / px * 100 if px else float("nan"), "atr_ratio": atr_ratio, "spread_atr": spread_atr,
            "flip_ratio": flips, "crosses": crosses}


# ──────────────────────────────────────────────────────────────────────────────
# 3. FLIP RISK (índice heurístico — NO probabilidad calibrada)
# ──────────────────────────────────────────────────────────────────────────────
def flip_risk(d: pd.DataFrame, x: XCfg, direction: int, chop: dict, z: Optional[float],
              tau_min: Optional[float]) -> dict:
    if direction == 0:
        return {"available": False, "why": "No hay una dirección actual (ni señal ni tendencia clara) respecto a la cual medir una reversión."}
    r = d.iloc[-1]
    atr = float(r["atr"]) if r["atr"] > 0 else float("nan")
    F: List[Tuple[float, str]] = []

    h = (d["macd_hist"].tail(4) * direction).to_numpy()
    if h[-1] <= 0:
        F.append((20, "El histograma MACD ya va en contra de la dirección actual"))
    elif len(h) == 4 and h[-1] < h[-2] < h[-3]:
        F.append((12, "El histograma MACD se debilita 2 velas seguidas (momentum agotándose)"))
    sp = (float(r["ema9"]) - float(r["ema21"])) * direction
    if sp < 0:
        F.append((15, "La EMA 9 cruzó en contra de la EMA 21"))
    elif np.isfinite(atr) and sp < 0.3 * atr:
        F.append((10, "EMA 9 y EMA 21 casi se tocan (cruce contrario inminente)"))
    rsi = float(r["rsi"])
    if (direction > 0 and rsi >= x.rsi_ob) or (direction < 0 and rsi <= x.rsi_os):
        F.append((12, f"RSI {rsi:.0f} en zona {'de sobrecompra' if direction > 0 else 'de sobreventa'}: movimiento sobreextendido"))
    elif (rsi - 50) * direction < 0:
        F.append((8, f"RSI {rsi:.0f} del lado contrario a la dirección"))
    adx = float(r["adx"])
    if adx < 20:
        F.append((10, f"ADX {adx:.0f}: tendencia débil, fácil de revertir"))
    elif adx < 25:
        F.append((5, f"ADX {adx:.0f}: tendencia moderada"))
    if z is not None and np.isfinite(z):
        fav = z * direction
        if fav < 0:
            F.append((15, "El precio está del lado contrario de la referencia del contrato"))
        elif fav < 0.5:
            F.append((12, f"El precio está muy cerca de la referencia (|z| = {abs(z):.2f})"))
        elif fav < 1.0:
            F.append((6, f"Colchón moderado sobre la referencia (z = {abs(z):.2f})"))
    if tau_min is not None:
        if tau_min > 10:
            F.append((8, f"Quedan {tau_min:.0f} min: hay mucho tiempo para un giro"))
        elif tau_min > 5:
            F.append((4, f"Quedan {tau_min:.0f} min"))
    sr = float(r["sigma_ratio"]) if np.isfinite(r["sigma_ratio"]) else None
    if sr is not None:
        if sr > 1.6:
            F.append((8, f"Volatilidad reciente disparada (σ reciente/σ 60 min = {sr:.2f})"))
        elif sr > 1.3:
            F.append((4, f"Volatilidad reciente elevada ({sr:.2f}×)"))
    if chop["points"] > 0:
        F.append((min(10, 3 * chop["points"]), f"Señales de mercado lateral ({chop['points']}/7 puntos de chop)"))
    opp = int(sum(1 for c_ in VOTE_COLS if r[c_] * direction == -1))
    if opp:
        F.append((min(12, 4 * opp), f"{opp} indicador(es) votan en contra de la dirección"))
    risk = float(min(100.0, sum(p for p, _ in F)))
    level = "HIGH" if risk > x.flip_high else "MEDIUM" if risk >= x.flip_med else "LOW"
    F.sort(key=lambda t: -t[0])
    return {"available": True, "risk": risk, "level": level, "factors": F, "dir": direction}


# ──────────────────────────────────────────────────────────────────────────────
# 2. SMART EXIT WATCH (solo advertencias)
# ──────────────────────────────────────────────────────────────────────────────
def exit_watch(d: pd.DataFrame, x: XCfg, pos_side: Optional[str], ctr: Any, q: dict, chart: dict,
               confirm_dir: int, entry_price: Optional[float]) -> dict:
    if pos_side not in ("UP", "DOWN"):
        return {"state": "NONE", "points": 0, "reasons": [], "pos": None}
    dr = btc_dir(pos_side, ctr)
    r = d.iloc[-1]
    atr = float(r["atr"])
    R_: List[Tuple[int, str]] = []

    h = (d["macd_hist"].tail(4) * dr).to_numpy()
    if h[-1] <= 0:
        R_.append((2, "Momentum en contra: el histograma MACD cambió de lado"))
    elif len(h) == 4 and h[-1] < h[-2] < h[-3]:
        R_.append((1, "Debilitamiento del momentum: el histograma MACD se achica 2 velas seguidas"))
    if np.isfinite(r["roc5"]) and r["roc5"] * dr < 0:
        R_.append((1, "El momentum de 5 velas ya apunta en contra de la posición"))

    sp = (d["ema9"] - d["ema21"]).to_numpy() * dr
    if sp[-1] < 0:
        recent = bool(np.any(sp[-4:-1] >= 0))
        R_.append((2, "Cruce contrario de EMA 9/21 " + ("(ocurrió en las últimas 3 velas)" if recent else "(vigente)")))

    rsi_now, rsi_3 = float(r["rsi"]), float(d["rsi"].iloc[-4])
    drsi = (rsi_now - rsi_3) * dr
    if drsi <= -15:
        R_.append((2, f"Cambio fuerte del RSI en contra ({rsi_3:.0f} → {rsi_now:.0f} en 3 velas)"))
    elif drsi <= -8:
        R_.append((1, f"Cambio importante del RSI en contra ({rsi_3:.0f} → {rsi_now:.0f} en 3 velas)"))
    if (rsi_now - 50) * dr < 0:
        R_.append((1, f"RSI {rsi_now:.0f} cruzó la línea de 50 en contra"))
    elif (dr > 0 and rsi_3 >= x.rsi_ob > rsi_now) or (dr < 0 and rsi_3 <= x.rsi_os < rsi_now):
        R_.append((1, "El RSI salió de la zona extrema a favor de la posición (agotamiento)"))

    if chart["dir"] == -dr:
        R_.append((2, f"Reversión de tendencia: el análisis técnico ahora es {chart['trend']}"))
    elif chart["dir"] == 0:
        R_.append((1, "La tendencia dejó de ser clara (NEUTRAL)"))

    if confirm_dir == -dr:
        R_.append((2, "La confirmación original se invirtió: las velas cerradas confirman la dirección contraria"))
    elif confirm_dir == 0:
        R_.append((1, "Se perdió la confirmación de la señal original (≥ 3 indicadores alineados y ninguno en contra)"))

    bid = q.get("yes_bid") if pos_side == "UP" else q.get("no_bid")
    pnl_txt = None
    if entry_price and bid is not None:
        pnl_txt = f"Valor de venta actual {bid * 100:.0f}¢ vs entrada {entry_price * 100:.0f}¢ ({(bid - entry_price) * 100:+.0f}¢ por contrato, antes de comisión)"
        if bid <= entry_price - 0.10:
            R_.append((1, f"El contrato perdió ≥ 10¢ desde tu entrada ({pnl_txt})"))
    pts = sum(p for p, _ in R_)
    cross_against = any("Cruce contrario" in t for _, t in R_)
    trend_rev = any("Reversión de tendencia" in t for _, t in R_)
    state = ("STRONG EXIT WARNING" if (pts >= 5 or (cross_against and trend_rev)) else
             "WARNING" if pts >= 2 else "SAFE TO MONITOR")
    return {"state": state, "points": pts, "reasons": R_, "pos": pos_side, "dir": dr, "pnl": pnl_txt,
            "bid": bid}


