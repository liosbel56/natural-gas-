VOTE_COLS = ["v_trend", "v_macd", "v_mom", "v_rsi", "v_px"]


def add_indicators(df: pd.DataFrame) -> pd.DataFrame:
    """Calcula indicadores sobre velas CERRADAS. La fila t solo usa filas ≤ t."""
    d = df[["time", "open", "high", "low", "close", "volume"]].copy().reset_index(drop=True)
    c, h, l = d["close"], d["high"], d["low"]
    for n in (9, 21, 50):
        d[f"ema{n}"] = c.ewm(span=n, adjust=False).mean()

    delta = c.diff()
    gain = delta.clip(lower=0).ewm(alpha=1 / 14, adjust=False).mean()
    loss = (-delta.clip(upper=0)).ewm(alpha=1 / 14, adjust=False).mean()
    rs = gain / loss.replace(0, np.nan)
    rsi = 100 - 100 / (1 + rs)
    rsi = rsi.where(~((loss == 0) & (gain > 0)), 100.0)
    rsi = rsi.where(~((loss == 0) & (gain == 0)), 50.0)
    d["rsi"] = rsi

    e12, e26 = c.ewm(span=12, adjust=False).mean(), c.ewm(span=26, adjust=False).mean()
    d["macd"] = e12 - e26
    d["macd_signal"] = d["macd"].ewm(span=9, adjust=False).mean()
    d["macd_hist"] = d["macd"] - d["macd_signal"]

    prev = c.shift(1)
    tr = pd.concat([h - l, (h - prev).abs(), (l - prev).abs()], axis=1).max(axis=1)
    atr = tr.ewm(alpha=1 / 14, adjust=False).mean()
    d["atr"] = atr

    up, dn = h.diff(), -l.diff()
    pdm = pd.Series(np.where((up > dn) & (up > 0), up, 0.0), index=d.index)
    mdm = pd.Series(np.where((dn > up) & (dn > 0), dn, 0.0), index=d.index)
    a = atr.replace(0, np.nan)
    pdi = 100 * pdm.ewm(alpha=1 / 14, adjust=False).mean() / a
    mdi = 100 * mdm.ewm(alpha=1 / 14, adjust=False).mean() / a
    dx = (100 * (pdi - mdi).abs() / (pdi + mdi).replace(0, np.nan)).fillna(0.0)
    d["plus_di"], d["minus_di"] = pdi, mdi
    d["adx"] = dx.ewm(alpha=1 / 14, adjust=False).mean()

    d["roc5"] = c / c.shift(5) - 1.0
    d["roc10"] = c / c.shift(10) - 1.0
    ret = np.log(c / c.shift(1))
    ewma_var = (ret ** 2).ewm(alpha=0.06, adjust=False).mean()
    roll_var = (ret ** 2).rolling(60, min_periods=30).mean()
    d["sigma_ratio"] = np.sqrt(ewma_var / roll_var.replace(0, np.nan))

    # Votos direccionales por vela (+1 alcista, −1 bajista, 0 neutral). Con banda muerta para no votar por ruido.
    ab = atr.replace(0, np.nan)
    d["v_trend"] = np.where((d["ema9"] > d["ema21"]) & (d["ema21"] > d["ema50"]), 1,
                            np.where((d["ema9"] < d["ema21"]) & (d["ema21"] < d["ema50"]), -1, 0))
    d["v_macd"] = np.where(d["macd_hist"] > 0.02 * ab, 1, np.where(d["macd_hist"] < -0.02 * ab, -1, 0))
    mv = c - c.shift(5)
    d["v_mom"] = np.where(mv > 0.25 * ab, 1, np.where(mv < -0.25 * ab, -1, 0))
    d["v_rsi"] = np.where(rsi >= 52, 1, np.where(rsi <= 48, -1, 0))
    pxd = c - d["ema21"]
    d["v_px"] = np.where(pxd > 0.1 * ab, 1, np.where(pxd < -0.1 * ab, -1, 0))
    V = d[VOTE_COLS].to_numpy()
    d["n_pos"] = (V == 1).sum(axis=1)
    d["n_neg"] = (V == -1).sum(axis=1)
    return d


def reading_series(d: pd.DataFrame, max_opp: int) -> np.ndarray:
    """Dirección confirmada por vela: +1 / −1 si ≥ 3 de 5 indicadores la apoyan y no más de `max_opp` la contradicen."""
    pos, neg = d["n_pos"].to_numpy(), d["n_neg"].to_numpy()
    return np.where((pos >= 3) & (neg <= max_opp), 1, np.where((neg >= 3) & (pos <= max_opp), -1, 0))


def trailing_streak(arr: np.ndarray) -> Tuple[int, int]:
    """(dirección, nº de velas consecutivas) al final de la serie; (0, 0) si la última lectura es neutral."""
    if len(arr) == 0 or arr[-1] == 0:
        return 0, 0
    s, n = arr[-1], 0
    for v in arr[::-1]:
        if v == s:
            n += 1
        else:
            break
    return int(s), n


def btc_dir(side: Optional[str], ctr: Any) -> int:
    """Dirección de BTC (+1/−1) que beneficia al lado comprado: UP=YES, DOWN=NO."""
    if side not in ("UP", "DOWN"):
        return 0
    yes_above = True if ctr is None else bool(getattr(ctr, "yes_if_above", True))
    return 1 if (side == "UP") == yes_above else -1


def dir_word(dr: int) -> str:
    return "ALCISTA" if dr > 0 else "BAJISTA" if dr < 0 else "NEUTRAL"


