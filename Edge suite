# 6. KALSHI CONTRACT ANALYSIS
# ──────────────────────────────────────────────────────────────────────────────
def contract_analysis(R: dict, chart: dict) -> dict:
    mk, ctr, q = R.get("mk"), R.get("ctr"), R.get("q") or {}
    if mk is None:
        return {"available": False}
    ya, yb, na, nb = q.get("yes_ask"), q.get("yes_bid"), q.get("no_ask"), q.get("no_bid")
    sp_y = (ya - yb) if (ya is not None and yb is not None) else None
    sp_n = (na - nb) if (na is not None and nb is not None) else None
    implied = R.get("implied")
    tech_yes = None
    if chart is not None and chart["dir"] != 0 and ctr is not None:
        yes_above = bool(ctr.yes_if_above)
        tech_yes = "UP" if (chart["dir"] > 0) == yes_above else "DOWN"
    mkt = None if implied is None else ("UP" if implied >= 0.55 else "DOWN" if implied <= 0.45 else "NEUTRAL")
    if tech_yes is None or mkt is None:
        align = "DATA UNAVAILABLE" if mkt is None else "técnica NEUTRAL"
    elif mkt == "NEUTRAL":
        align = "mercado indeciso (45–55 %)"
    else:
        align = "COINCIDEN" if tech_yes == mkt else "DIVERGEN"
    return {"available": True, "yes_ask": ya, "yes_bid": yb, "no_ask": na, "no_bid": nb, "sp_yes": sp_y, "sp_no": sp_n,
            "last": mk.get("last_price"), "implied": implied, "liquidity": mk.get("liquidity"),
            "ask_size": mk.get("yes_ask_size"), "bid_size": mk.get("yes_bid_size"), "volume": mk.get("volume"),
            "oi": mk.get("open_interest"), "tech_yes": tech_yes, "mkt": mkt, "align": align,
            "p_model": R.get("p_final")}


# ──────────────────────────────────────────────────────────────────────────────
# 5. COMPUERTA DE ENTRADA (se aplica sobre la decisión de app.py)
# ──────────────────────────────────────────────────────────────────────────────
def build_gate(d: pd.DataFrame, x: XCfg, cand_side: Optional[str], ctr: Any, entry_ask: Optional[float],
               chop: dict, flip: dict, readings: np.ndarray) -> Tuple[List[dict], dict]:
    names = {"chop": "Mercado lateral (CHOP)", "confirm": f"Confirmación ({x.confirm_n} velas cerradas seguidas)",
             "window": "Confirmación dentro del contrato actual", "contradiction": "Indicadores sin contradicciones",
             "late": "Entrada no tardía (RSI)", "price90": f"Precio de compra < {x.max_entry_price * 100:.0f}¢",
             "flip": "Flip Risk"}
    if cand_side is None or ctr is None:
        return [mkfilter(k, v, "na", blocking=False) for k, v in names.items()], {"dir": 0}
    dr = btc_dir(cand_side, ctr)
    r = d.iloc[-1]
    F: List[dict] = []

    # CHOP
    if chop["state"] == "CHOP":
        F.append(mkfilter("chop", names["chop"], "fail" if x.block_chop else "warn",
                          f"{chop['points']}/7 pts · ADX {chop['adx']:.0f}", f"< {x.chop_points} pts",
                          "Mercado lateral o sin dirección clara (" + "; ".join(t for _, t in chop["items"][:3]) + "). WAIT.",
                          blocking=x.block_chop))
    else:
        F.append(mkfilter("chop", names["chop"], "ok", f"{chop['state']} · {chop['points']}/7 pts · ADX {chop['adx']:.0f}",
                          f"< {x.chop_points} pts"))

    # Confirmación consecutiva (solo velas CERRADAS)
    n = x.confirm_n
    tail = readings[-n:] if len(readings) >= n else np.array([])
    ok_conf = len(tail) == n and bool(np.all(tail == dr))
    cnt = trailing_streak(readings)
    streak = cnt[1] if cnt[0] == dr else 0
    sym = {1: "↑", -1: "↓", 0: "·"}
    seq = " ".join(sym[int(v)] for v in readings[-4:])
    F.append(mkfilter("confirm", names["confirm"], "ok" if ok_conf else "fail", f"{streak}/{n} · últimas: {seq}",
                      f"{n} seguidas {'↑' if dr > 0 else '↓'}",
                      "" if ok_conf else f"Solo {streak} de {n} velas CERRADAS consecutivas confirman la dirección "
                      f"{dir_word(dr)}. Se espera confirmación antes de entrar (evita entradas tempranas)."))

    # Ventana: las velas confirmatorias deben haber cerrado dentro del contrato actual
    need = x.min_candles_in_window
    ws = pd.Timestamp(ctr.window_start) if getattr(ctr, "window_start", None) is not None else None
    if ws is None or need <= 0:
        F.append(mkfilter("window", names["window"], "na", blocking=False))
    else:
        inside = int((d["time"] >= ws).sum())
        w_ok = inside >= need
        F.append(mkfilter("window", names["window"], "ok" if w_ok else "fail", f"{inside} velas cerradas dentro",
                          f"≥ {need}",
                          "" if w_ok else f"Solo {inside} vela(s) cerrada(s) desde que empezó este contrato: no se emite "
                          "una señal solo porque comenzó un contrato nuevo."))

    # Contradicción en la última vela cerrada
    opp = [lab for lab, col in (("tendencia EMA", "v_trend"), ("MACD", "v_macd"), ("momentum", "v_mom"),
                                ("RSI", "v_rsi"), ("precio vs EMA 21", "v_px")) if r[col] * dr == -1]
    c_ok = len(opp) <= x.max_opposing
    F.append(mkfilter("contradiction", names["contradiction"], "ok" if c_ok else "fail",
                      f"{len(opp)} en contra" + (f" ({', '.join(opp)})" if opp else ""), f"≤ {x.max_opposing}",
                      "" if c_ok else "Los indicadores se contradicen: " + ", ".join(opp) + " apuntan en contra de la señal."))

    # Entrada tardía por RSI
    rsi = float(r["rsi"])
    late = (dr > 0 and rsi >= x.rsi_late_hi) or (dr < 0 and rsi <= x.rsi_late_lo)
    F.append(mkfilter("late", names["late"], "fail" if late else "ok", f"RSI {rsi:.0f}",
                      f"< {x.rsi_late_hi:.0f}" if dr > 0 else f"> {x.rsi_late_lo:.0f}",
                      f"RSI {rsi:.0f}: el movimiento ya está muy extendido; entrar ahora es una entrada tardía." if late else ""))

    # Precio ≥ 90¢
    if entry_ask is None:
        F.append(mkfilter("price90", names["price90"], "na", UNAVAILABLE, blocking=False))
    else:
        p_ok = entry_ask < x.max_entry_price - 1e-9
        F.append(mkfilter("price90", names["price90"], "ok" if p_ok else "fail", f"{entry_ask * 100:.0f}¢",
                          f"< {x.max_entry_price * 100:.0f}¢",
                          "" if p_ok else f"El contrato cuesta {entry_ask * 100:.0f}¢ (≥ {x.max_entry_price * 100:.0f}¢): "
                          "poco upside y mucho que perder; la entrada llegaría tarde."))

    # Flip risk (opcional)
    if x.block_high_flip and flip.get("available") and flip["level"] == "HIGH":
        F.append(mkfilter("flip", names["flip"], "fail", f"{flip['risk']:.0f}% HIGH", f"≤ {x.flip_high:.0f}%",
                          f"Riesgo de reversión ALTO ({flip['risk']:.0f}%): " + "; ".join(t for _, t in flip["factors"][:2]) + "."))
    elif flip.get("available"):
        F.append(mkfilter("flip", names["flip"], "ok" if flip["level"] != "HIGH" else "warn",
                          f"{flip['risk']:.0f}% {flip['level']}", "informativo", "", blocking=False))
    else:
        F.append(mkfilter("flip", names["flip"], "na", blocking=False))
    return F, {"dir": dr, "ok_conf": ok_conf, "streak": streak}


# ──────────────────────────────────────────────────────────────────────────────
# PUNTO DE ENTRADA: enriquece el resultado de analyze()
# ──────────────────────────────────────────────────────────────────────────────
def enhance(R: dict, x: XCfg, lean_fn: Callable[[Optional[float], dict], Optional[dict]],
            auto_position: Optional[str] = None) -> dict:
    """Añade R['X'] y aplica la compuerta de entrada a R['dec']. NO envía órdenes."""
    closed, ctr = R.get("closed"), R.get("ctr")
    X: Dict[str, Any] = {"ok": False, "why": ""}
    R["X"] = X
    if closed is None or len(closed) < MIN_BARS:
        X["why"] = (f"Se necesitan ≥ {MIN_BARS} velas cerradas de 1 min para el análisis avanzado "
                    f"(hay {0 if closed is None else len(closed)}).")
        return R
    d = add_indicators(closed)
    if not np.isfinite(d["adx"].iloc[-1]) or not np.isfinite(d["rsi"].iloc[-1]) or not d["atr"].iloc[-1] > 0:
        X["why"] = "Indicadores aún no válidos (NaN)."
        return R
    chart = chart_analysis(d, x)
    chop = chop_analysis(d, x)
    readings = reading_series(d, x.max_opposing)
    conf_dir, conf_n = trailing_streak(readings)

    dec = R["dec"]
    was_buy = str(dec.get("signal", "")).startswith("BUY")
    lean = R.get("lean")
    cand_side = dec.get("side") if was_buy else (lean["side"] if lean else None)
    entry_ask = None
    if cand_side and (dec.get("sides") or {}).get(cand_side):
        entry_ask = dec["sides"][cand_side]["ask"]
    mp = R.get("mp")
    z = None if mp is None else float(mp["z"])
    flip_dir = btc_dir(cand_side, ctr) if cand_side else chart["dir"]
    flip = flip_risk(d, x, flip_dir, chop, z, R.get("tau_min"))
    if flip.get("available"):
        flip["dir_txt"] = (f"señal {dec['signal']}" if was_buy else f"inclinación {cand_side}" if cand_side
                           else f"tendencia {chart['trend']}")
        flip["p_opp_model"] = None if (R.get("p_final") is None or cand_side is None) else \
            (1 - R["p_final"]) if cand_side == "UP" else R["p_final"]

    gate, gmeta = build_gate(d, x, cand_side, ctr, entry_ask, chop, flip, readings)
    fails = [f for f in gate if f["status"] == "fail" and f["blocking"]]
    dec["filters"] = list(dec["filters"]) + gate
    R["filters"] = list(R["filters"]) + gate
    downgraded = False
    if was_buy and fails:
        dec["signal"], dec["side"] = "ESPERAR", None
        dec["reasons"] = [f["detail"] for f in fails if f["detail"]] or ["Bloqueado por la compuerta de entrada."]
        downgraded = True
    R["signal"] = dec["signal"]
    R["blockers"] = [f for f in R["filters"] if f["status"] == "fail" and f["blocking"]]
    R["lean"] = lean_fn(R.get("p_final"), dec)

    pos = x.position
    if pos == "AUTO":
        pos = auto_position or "NONE"
    pos_side = pos if pos in ("UP", "DOWN") else None
    ex = exit_watch(d, x, pos_side, ctr, R.get("q") or {}, chart, conf_dir, x.entry_price)
    ex["auto"] = (x.position == "AUTO")
    cont = contract_analysis(R, chart)
    X.update({"ok": True, "d": d, "chart": chart, "chop": chop, "flip": flip, "exit": ex, "contract": cont,
              "gate": gate, "gate_meta": gmeta, "readings": readings, "conf_dir": conf_dir, "conf_n": conf_n,
              "cand_side": cand_side, "downgraded": downgraded, "was_buy": was_buy, "xcfg": x})
    return R


