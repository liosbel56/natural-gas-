import time
from btcbot.engine import BotEngine

def main():
    engine=BotEngine("config.toml")
    print("Bot iniciado en PAPER/SHADOW. Ctrl+C para detener.")
    try:
        while True:
            engine.step()
            s=engine.snapshot()
            print(time.strftime("%H:%M:%S"),s["signal"],"BTC=",s["btc"],"P_UP=",s["p_up"],"EDGE=",s["edge"],s["status"])
            time.sleep(engine.market_cfg["poll_seconds"])
    except KeyboardInterrupt:
        engine.stop()
if __name__=="__main__": main()
